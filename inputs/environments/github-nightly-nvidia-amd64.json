{
  "apiVersion": "nvkr.dev/environment/v1",
  "kind": "Environment",
  "metadata": {
    "name": "nvke-nightly-amd64-github",
    "description": "AMD64 GitHub-hosted candidate with required KVM and pipeline-attested build-provenance-v1 publication. Execution class resources are admission requirements, not evidence that the standard hosted label provides sufficient capacity. No private ARC runner is selected."
  },
  "githubRunners": {
    "linux/amd64": "ubuntu-24.04"
  },
  "diskEvidence": "build-provenance-v1",
  "executionClasses": [
    {
      "name": "github-hosted-amd64-kvm",
      "runsOn": "ubuntu-24.04",
      "hostPlatform": "linux/amd64",
      "resources": {
        "cpuMillis": 4000,
        "memoryMiB": 10240,
        "ephemeralStorageMiB": 65536
      },
      "maxTimeoutSeconds": 21600,
      "capabilities": [
        "kvm"
      ]
    }
  ],
  "publication": {
    "mode": "per-output-v1",
    "credentialRef": "github:NVKR_REGISTRY_WRITE",
    "repositoryPrefix": "ghcr.io/dsx-ai-factory/nvkr/nightly/nvke-nightly-amd64"
  },
  "runtime": {
    "runtime": "docker",
    "buildNetworkPolicy": "producer-declared"
  },
  "signing": {
    "identity": "^https://github\\.com/dsx-ai-factory/nvkr/\\.github/workflows/nvkr-run-nvke-nightly-amd64\\.yml@refs/heads/main$",
    "issuer": "https://token.actions.githubusercontent.com",
    "mode": "cosign"
  },
  "sourceAccess": {
    "https://github.com/dsx-ai-factory/ovn-kubernetes": {
      "credentialRef": "github:NKE_SOURCE_TOKEN",
      "mirror": "https://github.com/dsx-ai-factory/ovn-kubernetes"
    },
    "https://github.com/dsx-ai-factory/nvke": {
      "credentialRef": "github:NKE_SOURCE_TOKEN",
      "mirror": "https://github.com/dsx-ai-factory/nvke"
    },
    "https://github.com/dsx-ai-factory/nvke.git": {
      "credentialRef": "github:NKE_SOURCE_TOKEN",
      "mirror": "https://github.com/dsx-ai-factory/nvke"
    }
  },
  "utilityContainer": "busybox@sha256:29989570aeecad61a019f684218ea74d4b8c1c74f9e0abeb34ca926b81174ee1",
  "utilityPlatform": "linux/amd64",
  "githubBundle": "nvke-nightly-amd64",
  "githubRuntimePlan": true,
  "githubRuntimeSource": {
    "repository": "https://github.com/dsx-ai-factory/nvke",
    "ref": "refs/heads/main"
  },
  "githubHostedKVM": "native-amd64-v1"
}
